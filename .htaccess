# Apache Security & URL Rewriting Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory indexing
    Options -Indexes -MultiViews

    # Block access to hidden files and directories (e.g. .git, .env)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Block direct HTTP access to internal PHP directories
    RewriteRule ^(app|database|routes)/ - [F,L]

    # Block direct download of sensitive file extensions
    RewriteRule \.(sql|zip|tar|gz|7z|rar|exe|bat|ps1|sh|env|bak|conf|log|md)$ - [F,L]

    # Route everything else through index.php if not a real file in public
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Block access to sensitive files via FilesMatch
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|exe|zip|env|ps1))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
